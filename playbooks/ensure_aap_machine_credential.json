{
  "tool_name": "ensure_aap_machine_credential",
  "version": "1.0",
  "title": "Ensure AAP Machine Credential",
  "role": "action",
  "effect": "persistent",
  "description": "Check if an AAP Machine credential exists; create it if missing. Stop with an informational result if the organization is absent or the credential already exists.",
  "aap_template": "ensure_aap_machine_credential++Default",
  "organization": "Default",
  "execution_target": "controller",
  "connection": {
    "hosts": "localhost",
    "connection": "local",
    "gather_facts": false
  },
  "playbook_input": {
    "description": "Parameters the caller provides before execution",
    "parameters": [
      {
        "name": "aap_gateway_ip",
        "type": "string",
        "required": true,
        "default": null,
        "unit": null,
        "description": "IP or hostname of the AAP controller."
      },
      {
        "name": "aap_username",
        "type": "string",
        "required": true,
        "default": null,
        "unit": null,
        "description": "AAP admin username."
      },
      {
        "name": "aap_password",
        "type": "string",
        "required": true,
        "default": null,
        "unit": null,
        "description": "AAP admin password."
      },
      {
        "name": "organization_name",
        "type": "string",
        "required": true,
        "default": null,
        "unit": null,
        "description": "AAP organization name (must already exist)."
      },
      {
        "name": "credential_name",
        "type": "string",
        "required": true,
        "default": null,
        "unit": null,
        "description": "Desired Machine credential name."
      },
      {
        "name": "user_name",
        "type": "string",
        "required": true,
        "default": null,
        "unit": null,
        "description": "Username for the credential."
      },
      {
        "name": "user_password",
        "type": "string",
        "required": false,
        "default": "",
        "unit": null,
        "description": "Password for the credential. Leave empty if using SSH key."
      },
      {
        "name": "ssh_private_key",
        "type": "string",
        "required": false,
        "default": "",
        "unit": null,
        "description": "SSH private key for the credential. Leave empty if using password."
      },
      {
        "name": "sudo_password",
        "type": "string",
        "required": false,
        "default": "",
        "unit": null,
        "description": "Optional sudo password for the credential."
      },
      {
        "name": "credential_type",
        "type": "string",
        "required": false,
        "default": "Machine",
        "unit": null,
        "description": "Credential type (default: Machine)."
      }
    ]
  },
  "playbook_output": {
    "description": "What the emit step's <result> block contains",
    "output_wrapper": "<result>...</result>",
    "fields": [
      {
        "name": "credential_name",
        "type": "string",
        "nullable": false,
        "required_by_sop": true,
        "description": "Name of the credential that was checked or created."
      },
      {
        "name": "status",
        "type": "string",
        "nullable": false,
        "required_by_sop": true,
        "description": "Outcome: 'created', 'already_exists', or 'organization_missing'."
      },
      {
        "name": "message",
        "type": "string",
        "nullable": false,
        "required_by_sop": true,
        "description": "Human-readable message describing the outcome."
      },
      {
        "name": "credential_id",
        "type": "integer",
        "nullable": true,
        "required_by_sop": false,
        "description": "Numeric ID of the created credential (only present when status is 'created')."
      }
    ]
  },
  "steps": [
    {
      "id": "step-01",
      "type": "transform",
      "name": "Prepare API auth variables",
      "function": "Set the API host and credentials into intermediate variables for downstream steps.",
      "input": {
        "source": "playbook_input.parameters",
        "fields": [
          "aap_gateway_ip",
          "aap_username",
          "aap_password"
        ]
      },
      "computations": {
        "_aap_host": "{{ aap_gateway_ip }}",
        "_aap_user": "{{ aap_username }}",
        "_aap_pass": "{{ aap_password }}"
      },
      "stores": [
        "_aap_host",
        "_aap_user",
        "_aap_pass"
      ],
      "on_success": "step-02"
    },
    {
      "id": "step-02",
      "type": "collect",
      "name": "Look up organization",
      "function": "Query the AAP controller API for an organization with the given name.",
      "module": "ansible.controller.controller_api",
      "input": {
        "source": "playbook_input.parameters",
        "fields": [
          "organization_name"
        ]
      },
      "stores": [
        "_org_result"
      ],
      "on_success": "step-03",
      "on_fail": "step-11"
    },
    {
      "id": "step-03",
      "type": "decide",
      "name": "Does the organization exist?",
      "function": "Branch on whether step-02 found the specified organization.",
      "input": {
        "source": "step-02",
        "fields": [
          "_org_result"
        ]
      },
      "condition": "The organization lookup returned at least one result.",
      "on_pass": "step-04",
      "on_fail": "step-08"
    },
    {
      "id": "step-04",
      "type": "transform",
      "name": "Extract organization ID",
      "function": "Pull the numeric ID from the organization lookup result.",
      "input": {
        "source": "step-02",
        "fields": [
          "_org_result"
        ]
      },
      "computations": {
        "_org_id": "{{ _org_result[0].id }}"
      },
      "stores": [
        "_org_id"
      ],
      "on_success": "step-05"
    },
    {
      "id": "step-05",
      "type": "collect",
      "name": "Look up credential",
      "function": "Query the AAP controller API for a credential with the given name in the target organization.",
      "module": "ansible.controller.controller_api",
      "input": {
        "source": "step-04",
        "fields": [
          "_org_id"
        ]
      },
      "stores": [
        "_credential_result"
      ],
      "on_success": "step-06",
      "on_fail": "step-11"
    },
    {
      "id": "step-06",
      "type": "decide",
      "name": "Does the credential already exist?",
      "function": "Branch on whether step-05 found an existing credential.",
      "input": {
        "source": "step-05",
        "fields": [
          "_credential_result"
        ]
      },
      "condition": "The credential lookup returned at least one result.",
      "on_pass": "step-09",
      "on_fail": "step-07"
    },
    {
      "id": "step-07",
      "type": "action",
      "name": "Create Machine credential",
      "function": "Create the Machine credential using the idempotent ansible.controller.credential module.",
      "module": "ansible.controller.credential",
      "input": {
        "source": "playbook_input.parameters",
        "fields": [
          "organization_name",
          "credential_name",
          "user_name",
          "user_password",
          "ssh_private_key",
          "sudo_password",
          "credential_type"
        ]
      },
      "idempotent": true,
      "stores": [
        "_credential_creation_result"
      ],
      "on_success": "step-10",
      "on_fail": "step-11"
    },
    {
      "id": "step-08",
      "type": "transform",
      "name": "Set organization-absent output vars",
      "function": "Set the output variables indicating the organization is missing.",
      "input": {
        "source": "playbook_input.parameters",
        "fields": [
          "credential_name",
          "organization_name"
        ]
      },
      "computations": {
        "_credential_name": "{{ credential_name }}",
        "_status": "organization_missing",
        "_message": "Organization '{{ organization_name }}' does not exist in AAP.",
        "_credential_id": ""
      },
      "stores": [
        "_credential_name",
        "_status",
        "_message",
        "_credential_id"
      ],
      "on_success": "step-11"
    },
    {
      "id": "step-09",
      "type": "transform",
      "name": "Set credential-exists output vars",
      "function": "Set the output variables indicating the credential already exists.",
      "input": {
        "source": "playbook_input.parameters",
        "fields": [
          "credential_name"
        ]
      },
      "computations": {
        "_credential_name": "{{ credential_name }}",
        "_status": "already_exists",
        "_message": "Credential '{{ credential_name }}' already exists.",
        "_credential_id": ""
      },
      "stores": [
        "_credential_name",
        "_status",
        "_message",
        "_credential_id"
      ],
      "on_success": "step-11"
    },
    {
      "id": "step-10",
      "type": "transform",
      "name": "Set credential-created output vars",
      "function": "Set the output variables indicating the credential was created successfully.",
      "input": {
        "source": "step-07",
        "fields": [
          "_credential_creation_result"
        ]
      },
      "computations": {
        "_credential_name": "{{ credential_name }}",
        "_status": "created",
        "_message": "Credential '{{ credential_name }}' created with ID {{ _credential_creation_result.credential.id }}.",
        "_credential_id": "{{ _credential_creation_result.credential.id }}"
      },
      "stores": [
        "_credential_name",
        "_status",
        "_message",
        "_credential_id"
      ],
      "on_success": "step-11"
    },
    {
      "id": "step-11",
      "type": "emit",
      "name": "Emit result block",
      "function": "Print the Required Output Format <result> block with the appropriate outcome.",
      "output_fields": {
        "credential_name": "{{ _credential_name }}",
        "status": "{{ _status }}",
        "message": "{{ _message }}",
        "credential_id": "{{ _credential_id }}"
      },
      "on_success": "end"
    },
    {
      "id": "step-12",
      "type": "abort",
      "name": "Emit generic error and fail",
      "function": "Reached via the playbook's rescue block on any unexpected task failure. Prints a generic error and fails the play.",
      "error_message": "An unexpected error occurred during playbook execution.",
      "on_success": "end"
    }
  ],
  "error_handling": {
    "abort_step_id": "step-12",
    "no_silent_exit": true
  },
  "timeout_seconds": 300,
  "phases": [
    {
      "name": "Pre-checks",
      "description": "Set up API connectivity, verify organization and credential existence.",
      "steps": [
        "step-01",
        "step-02",
        "step-03",
        "step-04",
        "step-05",
        "step-06"
      ]
    },
    {
      "name": "Main action",
      "description": "Create the Machine credential.",
      "steps": [
        "step-07"
      ]
    },
    {
      "name": "Result preparation",
      "description": "Build the appropriate output variables for every possible outcome.",
      "steps": [
        "step-08",
        "step-09",
        "step-10"
      ]
    },
    {
      "name": "Reporting",
      "description": "Emit the structured final result to the caller.",
      "steps": [
        "step-11"
      ]
    },
    {
      "name": "Error handling",
      "description": "Reached only on unexpected runtime errors; prints a generic message and fails.",
      "steps": [
        "step-12"
      ]
    }
  ],
  "meta": {
    "content_sha256": "25db102efbbc40465eadc5e05a05de93a1c61e2158fa13a745185a91b5b2983f",
    "saved_at": "2026-07-21T12:01:23+00:00",
    "saved_by": "admin",
    "revision": 1
  }
}
